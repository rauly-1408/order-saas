generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  STORE_MANAGER
}

enum Channel {
  DELIVERY
  TAKEAWAY
}

// Módulos de pago que un restaurante puede contratar aparte del producto base.
enum Addon {
  COSTS // Costes y margen (escandallos, inventario, compras)
  RETENTION // Motor de retención (campañas)
}

// Unidad base de un ingrediente: la misma para el formato de compra y el escandallo.
enum BaseUnit {
  KG
  G
  L
  ML
  UNIT
}

// Tipo de movimiento de stock de un ingrediente (módulo Costes, fase 2).
enum StockMovementType {
  ORDER // consumo automático al entrar un pedido
  ORDER_CANCEL // devolución al cancelar un pedido
  RECEIPT // entrada de mercancía
  COUNT // recuento físico: la diferencia con el stock teórico (merma/descuadre)
  WASTE // merma declarada (caducado, roto, error…)
}

// Pedido a proveedor (módulo Costes, fase 3).
enum PurchaseOrderStatus {
  DRAFT // preparado, sin enviar
  SENT // enviado al proveedor (WhatsApp / email)
  RECEIVED // mercancía recibida → entra en stock
  CANCELLED
}

// Origen de un cambio de precio de compra.
enum PriceChangeSource {
  MANUAL // editado en la ficha del ingrediente
  RECEIPT // detectado al recibir un pedido
}

// Cómo paga el cliente: en el local (efectivo/datáfono) o con tarjeta online (Stripe).
enum PaymentMethod {
  IN_STORE
  CARD
}

// Estado del cobro online. Los pedidos IN_STORE quedan en UNPAID (se cobran en el local).
enum PaymentStatus {
  UNPAID
  PENDING // PaymentIntent creado, esperando confirmación del webhook
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  CREATED
  PAID
  SENT_TO_POS
  ACCEPTED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

// ─────────────────────────────────────────────
//  USER
// ─────────────────────────────────────────────
model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     Role   @default(TENANT_ADMIN)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  TENANT
//  Representa un restaurante/negocio.
//  branding y settings son JSON temporales.
//  Migración futura: extraer a tablas propias
//  (ver docs/architecture/tenant-config.md)
// ─────────────────────────────────────────────
model Tenant {
  id      String   @id @default(cuid())
  name    String
  slug    String   @unique
  domains String[] @default([])

  // Notificaciones (TASK-016)
  email                String?
  notificationsEnabled Boolean @default(true)
  dailySummaryEnabled  Boolean @default(true)

  // Stripe Connect (Express): el restaurante cobra a su nombre (merchant of record)
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)
  // Comisión de la plataforma en puntos básicos (300 = 3 %), solo en pagos online
  platformFeeBps       Int     @default(300)

  // Módulos contratados
  addons Addon[] @default([])

  // Identidad visual — temporal en JSON
  // TODO: migrar a tabla TenantTheme cuando exista el dashboard
  // Estructura esperada: { primaryColor, secondaryColor, backgroundColor,
  //   surfaceColor, textColor, accentColor, headingFont, bodyFont,
  //   borderRadius, cardStyle, logoUrl, faviconUrl, heroImageUrl }
  branding Json @default("{}")

  // Configuración operativa — temporal en JSON
  // TODO: migrar a tabla StoreSettings cuando exista el dashboard
  // Estructura esperada: { deliveryEnabled, takeawayEnabled,
  //   minimumOrderCents, deliveryFeeCents, estimatedDeliveryMinutes,
  //   estimatedPickupMinutes, openingHours, address, phone, whatsapp,
  //   instagram, timezone, currency }
  settings Json @default("{}")

  users          User[]
  stores         Store[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  orders         Order[]
  customers      Customer[]
  coupons        Coupon[]
  campaigns      Campaign[]
  promotions     Promotion[]
  loyaltyProgram LoyaltyProgram?
  brandAssets    BrandAsset[]
  comboSlots     ComboSlot[]
  reviews        Review[]
  suppliers      Supplier[]
  ingredients    Ingredient[]
  recipeLines    RecipeLine[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  priceChanges   IngredientPriceChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  STORE (local físico)
// ─────────────────────────────────────────────
model Store {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  address String?
  phone   String?
  email   String?
  active  Boolean @default(true)

  // Configuración de canales por local
  deliveryEnabled Boolean @default(true)
  takeawayEnabled Boolean @default(true)

  // Costes
  minimumOrderCents Int @default(0)
  deliveryFeeCents  Int @default(0)

  // Tiempos estimados (minutos)
  estimatedDeliveryMinutes Int @default(45)
  estimatedPickupMinutes   Int @default(20)

  // Horario semanal: { lun: [{ from: "13:00", to: "16:00" }, …], mar: …, dom: … }.
  // Vacío = siempre abierto. Ver lib/storeStatus.ts
  openingHours Json @default("{}")

  // Operativa en directo (Pedidos): pausa hasta una hora y minutos extra de preparación
  pausedUntil      DateTime?
  prepExtraMinutes Int       @default(0)

  orders        Order[]
  closures      StoreClosure[]
  deliveryZones DeliveryZone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  CATEGORY
// ─────────────────────────────────────────────
model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  slug        String
  description String? // NUEVO: descripción visible en la carta
  imageUrl    String? // NUEVO: imagen de cabecera de categoría

  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
}

// ─────────────────────────────────────────────
//  PRODUCT
// ─────────────────────────────────────────────
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name           String
  slug           String
  description    String?
  imageUrl       String? // NUEVO: imagen del producto
  basePriceCents Int     @default(0)

  isActive     Boolean @default(true)
  isAvailable  Boolean @default(true) // NUEVO: agotado temporal
  isFeatured   Boolean @default(false) // NUEVO: destacado en la carta
  hasModifiers Boolean @default(false)
  stockOut     Boolean @default(false) // agotado automático por falta de ingrediente (módulo Costes)

  sortOrder Int @default(0) // NUEVO: orden dentro de categoría

  modifierGroups ProductModifierGroup[]
  recipeLines    RecipeLine[]

  // Combo / menú a precio cerrado: basePriceCents es el precio del menú y
  // comboSlots los huecos que elige el cliente (ver docs/COMBOS.md)
  isCombo     Boolean         @default(false)
  comboSlots  ComboSlot[]     @relation("ComboSlots")
  comboChoice ComboSlotItem[] @relation("ComboChoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
}

// ─────────────────────────────────────────────
//  MODIFIER GROUP / OPTIONS
// ─────────────────────────────────────────────
model ModifierGroup {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  code       String
  isRequired Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)

  productModifierGroups ProductModifierGroup[]
  options               ModifierOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model ModifierOption {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id])

  name            String
  priceDeltaCents Int     @default(0)
  sortOrder       Int     @default(0)
  isAvailable     Boolean @default(true) // NUEVO
  stockOut        Boolean @default(false) // agotado automático por falta de ingrediente

  defaultFor  ProductModifierGroup[]
  recipeLines RecipeLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductModifierGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id])
  sortOrder Int           @default(0)

  // Opción preseleccionada para este producto (ej. el pan recomendado en la carta).
  defaultOptionId String?
  defaultOption   ModifierOption? @relation(fields: [defaultOptionId], references: [id], onDelete: SetNull)

  @@unique([productId, groupId])
}

// ─────────────────────────────────────────────
//  ORDER
// ─────────────────────────────────────────────
// Cierre programado (vacaciones, festivo, reforma…): no se aceptan pedidos.
model StoreClosure {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  reason   String?

  createdAt DateTime @default(now())

  @@index([storeId, endsAt])
}

// Zona de reparto por códigos postales, con su coste de envío y pedido mínimo.
// Si un local tiene zonas activas, solo se reparte a esos códigos postales.
model DeliveryZone {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name          String
  postalCodes   String[]
  feeCents      Int      @default(0)
  minOrderCents Int      @default(0)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  // Vínculo OPCIONAL con el CRM — se rellena por upsert (vía teléfono) al crear el pedido.
  // Mantenemos customerName/customerPhone como snapshot del pedido aunque exista Customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  orderNumber Int?

  channel Channel
  status  OrderStatus @default(CREATED)

  customerName       String
  customerPhone      String
  customerAddress    String?
  customerPostalCode String?
  notes              String?

  currency      String @default("EUR")
  subtotalCents Int    @default(0)
  feesCents     Int    @default(0)
  discountCents Int    @default(0) // descuento total: cupón + promoción + fidelización (ya restado en totalCents)
  totalCents    Int    @default(0)

  // Cupón aplicado (motor de retención)
  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  // Promoción automática aplicada (sin código) y premio de fidelización
  promotionId            String?
  promotion              Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionDiscountCents Int        @default(0)
  loyaltyReward          Boolean    @default(false) // este pedido canjeó el premio de la tarjeta
  loyaltyDiscountCents   Int        @default(0)

  // Pago
  paymentMethod         PaymentMethod @default(IN_STORE)
  paymentStatus         PaymentStatus @default(UNPAID)
  stripePaymentIntentId String?       @unique
  applicationFeeCents   Int           @default(0) // comisión de la plataforma cobrada en este pedido

  posProvider   String?
  posExternalId String?

  // Hora estimada (listo para recoger / entregado) calculada al crear el pedido,
  // con el tiempo extra que hubiera en ese momento. La ve el cliente al seguirlo.
  estimatedReadyAt DateTime?
  review           Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderLine[]

  @@unique([tenantId, orderNumber])
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId      String
  productName    String
  quantity       Int    @default(1)
  basePriceCents Int    @default(0)
  totalCents     Int    @default(0)

  // Modificadores seleccionados en JSON snapshot
  modifiers Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  CRM / RETENCIÓN  ← núcleo del diferenciador
//  Customer = identidad del comensal. Clave natural: (tenant + teléfono).
//  Se crea/actualiza por upsert al confirmar cada pedido.
// ─────────────────────────────────────────────
enum CustomerSegment {
  NEW // primer pedido o sin histórico suficiente
  REGULAR // pide con cierta frecuencia
  VIP // alto valor y/o alta frecuencia
  AT_RISK // antes habitual, lleva tiempo sin pedir
}

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // El teléfono es la clave de identidad en pedidos de restaurante
  phone String
  name  String?
  email String?

  // Segmentación (recalculada por job o al crear pedido)
  segment CustomerSegment @default(NEW)

  // Métricas agregadas — denormalizadas para no recalcular en cada lectura
  ordersCount     Int       @default(0)
  totalSpentCents Int       @default(0)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?

  // Consentimiento de marketing — REQUISITO LEGAL para WhatsApp/email (RGPD + LSSI)
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  tags  String[] @default([])
  notes String?

  orders        Order[]
  campaignSends CampaignSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, segment])
}

// ─────────────────────────────────────────────
//  CUPONES — usados por las campañas de retención
// ─────────────────────────────────────────────
enum DiscountType {
  PERCENT // value = % de descuento (ej. 10 = 10%)
  FIXED // value = céntimos de descuento
}

model Coupon {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code  String
  type  DiscountType @default(PERCENT)
  value Int // interpretado según DiscountType

  minOrderCents   Int     @default(0)
  maxRedemptions  Int? // null = ilimitado
  redeemedCount   Int     @default(0)
  oncePerCustomer Boolean @default(true) // cada teléfono solo puede usarlo una vez

  active    Boolean   @default(true)
  expiresAt DateTime?

  campaigns Campaign[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

// ─────────────────────────────────────────────
//  PROMOCIONES AUTOMÁTICAS (sin código) y TARJETA DE FIDELIDAD
//  Ver docs/PROMOCIONES-Y-FIDELIZACION.md
// ─────────────────────────────────────────────
enum PromotionKind {
  ORDER_PERCENT // value = % sobre el subtotal
  ORDER_FIXED // value = céntimos de descuento
  FREE_DELIVERY // envío gratis
}

model Promotion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name  String
  kind  PromotionKind
  value Int           @default(0)

  minOrderCents  Int       @default(0)
  weekdays       Int[]     @default([]) // días ISO 1-7 (lun-dom); vacío = todos
  startTime      String? // "HH:MM" en la hora del restaurante; null = todo el día
  endTime        String?
  channel        Channel? // null = domicilio y recogida
  firstOrderOnly Boolean   @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

model LoyaltyProgram {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  active         Boolean  @default(true)
  ordersRequired Int      @default(5) // el premio llega en el pedido nº N
  rewardName     String // "Bocadillo + bebida gratis"
  // Huecos del premio: [{ label: "Bocadillo", categoryIds: [...] }, { label: "Bebida", ... }]
  rewardSlots    Json     @default("[]")
  maxRewardCents Int? // tope del premio (null = sin tope)
  startsAt       DateTime @default(now()) // solo cuentan los pedidos desde aquí

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  CAMPAÑAS DE RETENCIÓN
//  Apuntan a un segmento y se envían por un canal.
//  El cupón es opcional (la campaña puede ser solo un mensaje).
// ─────────────────────────────────────────────
enum CampaignChannel {
  WHATSAPP
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name          String
  channel       CampaignChannel @default(WHATSAPP)
  targetSegment CustomerSegment

  // Plantilla del mensaje (puede venir generada por IA)
  messageBody String

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  recipientsCount Int @default(0)

  sends CampaignSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
//  ENVÍOS — un registro por (campaña, cliente).
//  Permite dedupe, medir conversión y no re-impactar al mismo cliente.
// ─────────────────────────────────────────────
enum SendStatus {
  PENDING
  SENT
  FAILED
  CONVERTED // el cliente pidió tras recibir el mensaje
}

model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status SendStatus @default(PENDING)
  sentAt DateTime?

  // Atribución: pedido que hizo el cliente tras recibir el mensaje
  convertedAt      DateTime?
  convertedOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, customerId])
  @@index([customerId, status])
}

// ─────────────────────────────────────────────
//  MÓDULO COSTES — proveedores, ingredientes y escandallos
//  Ver docs/MODULO-COSTES.md
// ─────────────────────────────────────────────
// Cómo prefiere recibir los pedidos el proveedor (decide el botón principal en Compras).
enum SupplierOrderMethod {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
}

model Supplier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  contactName String?
  phone       String?
  whatsapp    String? // si es null se usa el teléfono
  email       String?
  extraEmails String[] @default([]) // copias del pedido (administración, almacén…)
  notes       String?

  orderMethod SupplierOrderMethod @default(WHATSAPP)

  // Reparto estructurado → próxima entrega exacta (ver lib/purchasing nextDeliveryOffset)
  deliveryDays  Int[]   @default([]) // 1 = lunes … 7 = domingo
  leadDays      Int     @default(1) // con cuántos días de antelación hay que pedir
  orderCutoff   String? // hora límite de ese día, "HH:MM" (null = todo el día)
  minOrderCents Int? // pedido mínimo del proveedor

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model Ingredient {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  name     String
  baseUnit BaseUnit

  // Formato de compra: p. ej. caja de 5000 g a 12,50 € → packSize 5000, packPriceCents 1250
  packSize       Float
  packPriceCents Int

  // Merma (% que se pierde al limpiar/preparar): encarece el coste útil
  wastePct  Float    @default(0)
  allergens String[] @default([])
  isActive  Boolean  @default(true)

  // Inventario (fase 2): solo se descuenta si trackStock está activo
  trackStock Boolean @default(false)
  stockQty   Float   @default(0) // stock teórico en unidad base
  minStock   Float? // aviso de stock bajo

  recipeLines    RecipeLine[]
  stockMovements StockMovement[]
  purchaseLines  PurchaseOrderLine[]
  priceChanges   IngredientPriceChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

// Línea de escandallo: cantidad de un ingrediente (en su unidad base) que lleva
// un producto O una opción de modificador (pan, guarnición, salsa…).
model RecipeLine {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float

  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierOptionId String?
  modifierOption   ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, modifierOptionId])
}

// Historial de stock: cada cambio queda registrado con su valor en el momento.
model StockMovement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  type       StockMovementType
  quantity   Float // variación con signo, en unidad base (-120 = salen 120 g)
  stockAfter Float // stock teórico tras el movimiento
  valueCents Int // valor de la variación al coste útil del momento (con signo)

  orderId String?
  note    String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([ingredientId, createdAt])
}

// Pedido a un proveedor. Al recibirlo genera entradas de stock (RECEIPT).
model PurchaseOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  number     Int // correlativo por restaurante
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  sentAt     DateTime?
  expectedAt DateTime? // entrega prevista según el reparto del proveedor
  receivedAt DateTime?

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  quantity         Float // pedido, en unidad base
  packPriceCents   Int // precio del formato al hacer el pedido
  receivedQuantity Float? // lo que llegó realmente
}

// Historial de precios de compra: cada subida/bajada queda registrada.
model IngredientPriceChange {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  oldPackSize       Float
  oldPackPriceCents Int
  newPackSize       Float
  newPackPriceCents Int
  source            PriceChangeSource

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────
//  IMÁGENES DE MARCA (Personalización)
//  Se guardan en la propia base de datos (ya comprimidas en el navegador) y se
//  sirven en /api/brand/[tenant]/[kind]. Ver docs/PERSONALIZACION.md
// ─────────────────────────────────────────────
enum BrandAssetKind {
  FAVICON
  LOGO // logotipo principal (horizontal)
  LOGO_MONO // blanco y negro, para tickets impresos
  LOGO_SQUARE // cuadrado 1:1: icono de la app, perfiles
  HERO // imagen de cabecera de la carta
}

model BrandAsset {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  kind     BrandAssetKind
  mimeType String
  data     Bytes
  width    Int
  height   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind])
}

// ─────────────────────────────────────────────
//  COMBOS / MENÚS
//  Un combo es un Product (isCombo) con huecos: "Elige tu mollete",
//  "Elige tu bebida"… En cada hueco el cliente elige un producto de la lista,
//  con suplemento opcional. Ver docs/COMBOS.md
// ─────────────────────────────────────────────
model ComboSlot {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  comboId String
  combo   Product @relation("ComboSlots", fields: [comboId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  items ComboSlotItem[]

  @@index([comboId])
}

model ComboSlotItem {
  id     String    @id @default(cuid())
  slotId String
  slot   ComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  productId  String
  product    Product @relation("ComboChoice", fields: [productId], references: [id], onDelete: Cascade)
  extraCents Int     @default(0) // suplemento por elegir este producto
  sortOrder  Int     @default(0)

  @@unique([slotId, productId])
}

// ─────────────────────────────────────────────
//  RESEÑAS
//  El cliente valora su pedido (1-5 estrellas) desde la página de seguimiento,
//  una vez entregado. Una por pedido. Ver docs/SEGUIMIENTO-Y-RESENAS.md
// ─────────────────────────────────────────────
model Review {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
