generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  STORE_MANAGER
}

enum Channel {
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  CREATED
  PAID
  SENT_TO_POS
  ACCEPTED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

// ─────────────────────────────────────────────
//  USER
// ─────────────────────────────────────────────
model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     Role   @default(TENANT_ADMIN)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  TENANT
//  Representa un restaurante/negocio.
//  branding y settings son JSON temporales.
//  Migración futura: extraer a tablas propias
//  (ver docs/architecture/tenant-config.md)
// ─────────────────────────────────────────────
model Tenant {
  id      String   @id @default(cuid())
  name    String
  slug    String   @unique
  domains String[] @default([])

  // Identidad visual — temporal en JSON
  // TODO: migrar a tabla TenantTheme cuando exista el dashboard
  // Estructura esperada: { primaryColor, secondaryColor, backgroundColor,
  //   surfaceColor, textColor, accentColor, headingFont, bodyFont,
  //   borderRadius, cardStyle, logoUrl, faviconUrl, heroImageUrl }
  branding Json @default("{}")

  // Configuración operativa — temporal en JSON
  // TODO: migrar a tabla StoreSettings cuando exista el dashboard
  // Estructura esperada: { deliveryEnabled, takeawayEnabled,
  //   minimumOrderCents, deliveryFeeCents, estimatedDeliveryMinutes,
  //   estimatedPickupMinutes, openingHours, address, phone, whatsapp,
  //   instagram, timezone, currency }
  settings Json @default("{}")

  users          User[]
  stores         Store[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  orders         Order[]
  customers      Customer[]
  coupons        Coupon[]
  campaigns      Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  STORE (local físico)
// ─────────────────────────────────────────────
model Store {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  address String?
  phone   String?
  email   String?
  active  Boolean @default(true)

  // Configuración de canales por local
  deliveryEnabled  Boolean @default(true)
  takeawayEnabled  Boolean @default(true)

  // Costes
  minimumOrderCents Int @default(0)
  deliveryFeeCents  Int @default(0)

  // Tiempos estimados (minutos)
  estimatedDeliveryMinutes Int @default(45)
  estimatedPickupMinutes   Int @default(20)

  // Horarios en JSON: { mon: [{open: "09:00", close: "22:00"}], ... }
  openingHours Json @default("{}")

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  CATEGORY
// ─────────────────────────────────────────────
model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  slug        String
  description String? // NUEVO: descripción visible en la carta
  imageUrl    String? // NUEVO: imagen de cabecera de categoría

  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
}

// ─────────────────────────────────────────────
//  PRODUCT
// ─────────────────────────────────────────────
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name          String
  slug          String
  description   String?
  imageUrl      String? // NUEVO: imagen del producto
  basePriceCents Int    @default(0)

  isActive    Boolean @default(true)
  isAvailable Boolean @default(true) // NUEVO: agotado temporal
  isFeatured  Boolean @default(false) // NUEVO: destacado en la carta
  hasModifiers Boolean @default(false)

  sortOrder Int @default(0) // NUEVO: orden dentro de categoría

  modifierGroups ProductModifierGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
}

// ─────────────────────────────────────────────
//  MODIFIER GROUP / OPTIONS
// ─────────────────────────────────────────────
model ModifierGroup {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  code       String
  isRequired Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)

  productModifierGroups ProductModifierGroup[]
  options               ModifierOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model ModifierOption {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id])

  name           String
  priceDeltaCents Int   @default(0)
  sortOrder      Int    @default(0)
  isAvailable    Boolean @default(true) // NUEVO

  defaultFor ProductModifierGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductModifierGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id])
  sortOrder Int           @default(0)

  // Opción preseleccionada para este producto (ej. el pan recomendado en la carta).
  defaultOptionId String?
  defaultOption   ModifierOption? @relation(fields: [defaultOptionId], references: [id], onDelete: SetNull)

  @@unique([productId, groupId])
}

// ─────────────────────────────────────────────
//  ORDER
// ─────────────────────────────────────────────
model Order {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  // Vínculo OPCIONAL con el CRM — se rellena por upsert (vía teléfono) al crear el pedido.
  // Mantenemos customerName/customerPhone como snapshot del pedido aunque exista Customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  orderNumber Int?

  channel Channel
  status  OrderStatus @default(CREATED)

  customerName        String
  customerPhone       String
  customerAddress     String?
  customerPostalCode  String?
  notes               String?

  currency      String @default("EUR")
  subtotalCents Int    @default(0)
  feesCents     Int    @default(0)
  totalCents    Int    @default(0)

  posProvider   String?
  posExternalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderLine[]

  @@unique([tenantId, orderNumber])
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId      String
  productName    String
  quantity       Int    @default(1)
  basePriceCents Int    @default(0)
  totalCents     Int    @default(0)

  // Modificadores seleccionados en JSON snapshot
  modifiers Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  CRM / RETENCIÓN  ← núcleo del diferenciador
//  Customer = identidad del comensal. Clave natural: (tenant + teléfono).
//  Se crea/actualiza por upsert al confirmar cada pedido.
// ─────────────────────────────────────────────
enum CustomerSegment {
  NEW     // primer pedido o sin histórico suficiente
  REGULAR // pide con cierta frecuencia
  VIP     // alto valor y/o alta frecuencia
  AT_RISK // antes habitual, lleva tiempo sin pedir
}

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // El teléfono es la clave de identidad en pedidos de restaurante
  phone String
  name  String?
  email String?

  // Segmentación (recalculada por job o al crear pedido)
  segment CustomerSegment @default(NEW)

  // Métricas agregadas — denormalizadas para no recalcular en cada lectura
  ordersCount     Int       @default(0)
  totalSpentCents Int       @default(0)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?

  // Consentimiento de marketing — REQUISITO LEGAL para WhatsApp/email (RGPD + LSSI)
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  tags  String[] @default([])
  notes String?

  orders        Order[]
  campaignSends CampaignSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, segment])
}

// ─────────────────────────────────────────────
//  CUPONES — usados por las campañas de retención
// ─────────────────────────────────────────────
enum DiscountType {
  PERCENT // value = % de descuento (ej. 10 = 10%)
  FIXED   // value = céntimos de descuento
}

model Coupon {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code  String
  type  DiscountType @default(PERCENT)
  value Int          // interpretado según DiscountType

  minOrderCents  Int  @default(0)
  maxRedemptions Int? // null = ilimitado
  redeemedCount  Int  @default(0)

  active    Boolean   @default(true)
  expiresAt DateTime?

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

// ─────────────────────────────────────────────
//  CAMPAÑAS DE RETENCIÓN
//  Apuntan a un segmento y se envían por un canal.
//  El cupón es opcional (la campaña puede ser solo un mensaje).
// ─────────────────────────────────────────────
enum CampaignChannel {
  WHATSAPP
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name          String
  channel       CampaignChannel @default(WHATSAPP)
  targetSegment CustomerSegment

  // Plantilla del mensaje (puede venir generada por IA)
  messageBody String

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  recipientsCount Int @default(0)

  sends CampaignSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
//  ENVÍOS — un registro por (campaña, cliente).
//  Permite dedupe, medir conversión y no re-impactar al mismo cliente.
// ─────────────────────────────────────────────
enum SendStatus {
  PENDING
  SENT
  FAILED
  CONVERTED // el cliente pidió tras recibir el mensaje
}

model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status SendStatus @default(PENDING)
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, customerId])
}
